# Secrets (DB_PASSWORD, REDIS_PASSWORD, REDIS_CACHE_PASSWORD, SECRET_KEY,
# SUPERUSER_API_TOKEN, SUPERUSER_PASSWORD, AUTH_LDAP_BIND_PASSWORD,
# API_TOKEN_PEPPER_1) come from the Komodo Stack environment, see
# compose.override.yaml.
CORS_ORIGIN_ALLOW_ALL=True
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_WAIT_DEBUG=1
EMAIL_FROM=netbox@ffmuc.net
EMAIL_PASSWORD=
EMAIL_PORT=25
EMAIL_SERVER=localhost
EMAIL_SSL_CERTFILE=
EMAIL_SSL_KEYFILE=
EMAIL_TIMEOUT=5
EMAIL_USERNAME=netbox
# EMAIL_USE_SSL and EMAIL_USE_TLS are mutually exclusive, i.e. they can't both be `true`!
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
GRAPHQL_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media
METRICS_ENABLED=false
REDIS_CACHE_DATABASE=1
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false
REDIS_CACHE_SSL=false
REDIS_DATABASE=0
REDIS_HOST=redis
REDIS_INSECURE_SKIP_TLS_VERIFY=false
REDIS_SSL=false
RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases
SKIP_SUPERUSER=false
SUPERUSER_EMAIL=hilfe@ffmuc.net
SUPERUSER_NAME=admin
WEBHOOKS_ENABLED=true

## Custom additions
# For DNS module
#EXEMPT_VIEW_PERMISSIONS=*

# LDAP data
AUTH_LDAP_SERVER_URI=ldaps://ldap.ov.ffmuc.net
AUTH_LDAP_BIND_DN=uid=netbox,ou=Services,dc=ffmuc,dc=net
AUTH_LDAP_USER_SEARCH_BASEDN=OU=Users,DC=ffmuc,DC=net
AUTH_LDAP_USER_SEARCH_ATTR=CN
AUTH_LDAP_GROUP_SEARCH_CLASS=posixGroup
AUTH_LDAP_GROUP_TYPE=PosixGroupType
AUTH_LDAP_USER_DN_TEMPLATE=cn=%(user)s,ou=Users,dc=ffmuc,dc=net
AUTH_LDAP_GROUP_SEARCH_BASEDN=ou=Groups,dc=ffmuc,dc=net
AUTH_LDAP_REQUIRE_GROUP_DN=cn=Admin,ou=Groups,dc=ffmuc,dc=net
AUTH_LDAP_IS_ADMIN_DN=cn=Admin,ou=Groups,dc=ffmuc,dc=net
AUTH_LDAP_IS_SUPERUSER_DN=cn=Admin,ou=Groups,dc=ffmuc,dc=net
AUTH_LDAP_FIND_GROUP_PERMS=True

#NETBOX_DELETE_LEGACY_DATA=1
COPILOT_ENABLED=false
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_BACKEND=netbox.authentication.LDAPBackend
