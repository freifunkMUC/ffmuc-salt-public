# Secrets (SECRET_KEY, DB_PASSWORD, REDIS_PASSWORD, REDIS_CACHE_PASSWORD,
# PEERINGDB_PASSWORD, PEERINGDB_API_KEY) come from the Komodo Stack
# environment, see compose.override.yaml. SUPERUSER_* are the upstream
# defaults and are not used (SKIP_SUPERUSER=true).
DEBUG=false
ALLOWED_HOSTS=*
DB_NAME=peering_manager
DB_USER=peering_manager
DB_HOST=postgres
EMAIL_FROM_ADDRESS=peering@example.com
# DB_PORT=
# DB_SSLMODE=
# DB_CONN_MAX_AGE
# EMAIL_SERVER=localhost
# EMAIL_PORT=25
# EMAIL_USERNAME=peering-manager
# EMAIL_PASSWORD=
# EMAIL_TIMEOUT=5
# EMAIL_SUBJECT_PREFIX=
# EMAIL_USE_SSL and EMAIL_USE_TLS are mutually exclusive, i.e. they can't both be `true`!
# EMAIL_USE_SSL=false
# EMAIL_USE_TLS=false
# EMAIL_SSL_CERTFILE=
# EMAIL_SSL_KEYFILE=
PEERINGDB_USERNAME=ffmuc
# PEERINGDB_SYNC_INTERVAL=86400
# HOUSEKEEPING_INTERVAL=86400
# NAPALM_USERNAME=
# NAPALM_PASSWORD=
# NAPALM_TIMEOUT=
# BGPQ3_PATH=
# BGPQ3_HOST=
# BGPQ3_SOURCES=
# NETBOX_API=
# NETBOX_API_TOKEN=
# NETBOX_API_THREADING=
# NETBOX_API_VERIFY_SSL=
# NETBOX_DEVICE_ROLES=
# METRICS_ENABLED=False
REDIS_HOST=redis
REDIS_CACHE_HOST=redis-cache
SKIP_SUPERUSER=true
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@bar.com
SUPERUSER_PASSWORD=admin
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
