# Dovecot 2.4 syntax (docker-mailserver 16 and 17). docker-mailserver copies this
# file to /etc/dovecot/local.conf, which dovecot.conf includes last.

# Dovecot defaults: 10 and 100.
mail_max_userip_connections = 100
default_process_limit = 500

# Mails are encrypted at rest with one global EC key pair (mail_crypt, global
# keys mode), for IMAP, POP3 and LMTP as under 2.3. The blocks add to the
# plugin lists of docker-mailserver's own conf.d/20-*.conf (quota, imap_quota,
# sieve). crypt_write_algorithm keeps its default aes-256-gcm-sha256, which is
# what mail_crypt_save_version = 2 wrote under 2.3.
protocol imap {
  mail_plugins {
    mail_crypt = yes
  }
}
protocol pop3 {
  mail_plugins {
    mail_crypt = yes
  }
}
protocol lmtp {
  mail_plugins {
    mail_crypt = yes
  }
}

# Read by the config process as root, like "<file" under 2.3. Keys in PEM
# pkey format (BEGIN PRIVATE KEY / BEGIN PUBLIC KEY), P-256.
crypt_global_public_key_file = /certs/ecpubkey.pem
crypt_global_private_key main {
  crypt_private_key_file = /certs/ecprivkey.pem
}
