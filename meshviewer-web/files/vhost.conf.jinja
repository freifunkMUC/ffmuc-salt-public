# Managed by Salt (meshviewer-web). yanic rewrites the files every minute: revalidate, compress.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ in_name }} {{ fqdn }};
    root /srv/www/{{ fqdn }};

    ssl_certificate /etc/letsencrypt/live/{{ fqdn }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ fqdn }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/{{ fqdn }}_access.log;
    error_log /var/log/nginx/{{ fqdn }}_error.log;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/geo+json;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Access-Control-Allow-Origin * always;
    add_header Cache-Control "no-cache" always;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location ~ \.geojson$ {
        types { }
        default_type application/geo+json;
    }

    location ~ /\. {
        deny all;
    }
}

# Port 80 is the stream proxy in nginx.conf (nginx.gateway). certbot renews with the webroot below.
server {
    listen 127.0.0.1:8080 proxy_protocol;
    server_name {{ in_name }} {{ fqdn }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        if ($host = {{ fqdn }}) {
            return 301 https://$host$request_uri;
        }
        return 404;
    }
}
