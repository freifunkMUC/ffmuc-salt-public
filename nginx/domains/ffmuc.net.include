# Force HTTPS connection. This rules is domain agnostic
if ($scheme != "https") {
	return 301 https://$host$request_uri;
}

if ( $host = wiki.ffmuc.net ) {
	return 301 https://ffmuc.net/wiki/doku.php;
}
root /srv/www/ffmuc.net/_site/;

index index.html;

location /favicon.ico {
	root /srv/www/ffmuc.net/_site/assets/;
}

location = /captive {
	default_type application/captive+json;
}

location = /captive-bachtal {
	default_type application/captive+json;
}

# Point SSID-URL to ffmuc.net
rewrite ^/(uml_.*|muc_.*|gauting|freising|augsburg|welt|ulm)$ https://ffmuc.net redirect;

location ~ ^/speed(.*)$ {
	return 301 https://speed.ffmuc.net$1;
}

location /pad {
    rewrite         /pad/(.*) /$1 break;
    rewrite         ^/pad$ /pad/ permanent;
    proxy_redirect  / /pad/;

    proxy_pass         http://etherpad_upstream;
    proxy_buffering    off; # be careful, this line doesn't override any proxy_buffering on set in a conf.d/file.conf
    proxy_set_header   Host $host;
    proxy_pass_header  Server;

    # Note you might want to pass more headers etc too. See above configs.
}

location /pad/socket.io {
    rewrite         /pad/socket.io/(.*) /socket.io/$1 break;
    proxy_redirect  / /pad/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_pass         http://etherpad_upstream;
    proxy_buffering    off; # be careful, this line doesn't override any proxy_buffering on set in a conf.d/file.conf
    proxy_set_header   Host $host;
    proxy_pass_header  Server;
proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Note you might want to pass more headers etc too. See above configs.
}



location /pad/admin {
    rewrite         /pad/admin/(.*) /admin/$1 break;
    proxy_redirect  / /pad/;
proxy_set_header   X-Proxy-Path /pad;
    proxy_pass         http://etherpad_upstream;

    proxy_buffering    off; # be careful, this line doesn't override any proxy_buffering on set in a conf.d/file.conf
    proxy_set_header   Host $host;
    proxy_pass_header  Server;

    # Note you might want to pass more headers etc too. See above configs.
}


location /pad/admin-auth {
    rewrite         /pad/admin-auth/(.*) /admin-auth/$1 break;
    proxy_redirect  / /pad/;
proxy_set_header   X-Proxy-Path /pad;
    proxy_pass         http://etherpad_upstream;

    proxy_buffering    off; # be careful, this line doesn't override any proxy_buffering on set in a conf.d/file.conf
    proxy_set_header   Host $host;
    proxy_pass_header  Server;

    # Note you might want to pass more headers etc too. See above configs.
}

location /pad/static {
    rewrite  /pad/static/(.*) /static/$1 break;

    proxy_pass         http://etherpad_upstream;
    proxy_buffering    off; # be careful, this line doesn't override any proxy_buffering on set in a conf.d/file.conf
    proxy_set_header   Host $host;
    proxy_pass_header  Server;

    # Note you might want to pass more headers etc too. See above configs.
}

location /static {
	rewrite /static/(.*) /static/$1 break;
	proxy_pass http://wiki_upstream/;
	proxy_set_header Host $host;
	proxy_buffering off;
}

location /wiki/ {
#deny all;
	# The media manager (?do=media) is only for signed-in users: scrapers crawl
	# its endless image/ns/tab combinations from thousands of addresses, and
	# every request costs PHP and LDAP on docker04. Files stay public below
	# /wiki/_media/. DokuWiki sets the DW<md5> cookie only at sign-in.
	set $wiki_media_anon "";
	if ($arg_do = "media") {
		set $wiki_media_anon "media";
	}
	if ($http_cookie !~ "DW[0-9a-f]{32}=") {
		set $wiki_media_anon "${wiki_media_anon}-anon";
	}
	if ($wiki_media_anon = "media-anon") {
		return 403;
	}
	proxy_pass         http://wiki_upstream/;
	proxy_redirect     off;
	proxy_set_header   Host $host;
	proxy_set_header   X-Real-IP $remote_addr;
	proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header   X-Forwarded-Host $server_name;
	proxy_http_version 1.1;
	client_max_body_size 200M;
	proxy_request_buffering off;

	# Matomo (cookieless); Accept-Encoding is cleared so sub_filter sees uncompressed HTML
	proxy_set_header   Accept-Encoding "";
	sub_filter_once    on;
	sub_filter         '</head>' '<script>var _paq=window._paq=window._paq||[];_paq.push(["disableCookies"]);_paq.push(["setDoNotTrack",true]);_paq.push(["trackPageView"]);_paq.push(["enableLinkTracking"]);(function(){var u="https://matomo.ffmuc.net/";_paq.push(["setTrackerUrl",u+"matomo.php"]);_paq.push(["setSiteId","4"]);var d=document,g=d.createElement("script"),s=d.getElementsByTagName("script")[0];g.async=true;g.src=u+"matomo.js";s.parentNode.insertBefore(g,s);})();</script></head>';
}

location /draw/ {
	rewrite /draw/d/(.*)/socket.io/(.*) /socket.io/$2 break;
	rewrite /draw/d/(.*) /boards/$1 break;
	# wbo v2 serves the tools only below /tools/ (v1 served both paths)
	proxy_pass          http://draw_upstream/;
	proxy_ssl_server_name on;
	proxy_set_header    Upgrade $http_upgrade;
	proxy_set_header    Connection "upgrade";
	proxy_set_header Host "wbo.ophir.dev";
	proxy_ssl_name  $proxy_host;
	proxy_buffering off;
}

location /draw2 {
	rewrite /draw2/d/(.*) /boards/$1 break;
	proxy_pass https://wbo.ophir.dev;
	proxy_ssl_server_name on;
	proxy_set_header Host "wbo.ophir.dev";
	proxy_ssl_name $proxy_host;
	proxy_buffering off;
}

location /router-flashen {
	return "https://ffmuc.net/wiki/doku.php?id=knb:flash";
}
location /map {
	return https://map.ffmuc.net;
}

location /podcast/ {
	deny all;
}

access_log /var/log/nginx/hp.ffmuc.net_access.log json_normal;
error_log /var/log/nginx/hp.ffmuc.net_error.log;
