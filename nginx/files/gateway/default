# Managed by Salt (nginx.gateway). Gluon nodes poll this page.
server {
	# Port 80 is the stream proxy in nginx.conf.
	listen 127.0.0.1:8080 proxy_protocol default_server;

	root /var/www/html;
	index index.html index.htm index.nginx-debian.html;

	server_name _;

	location / {
		try_files $uri $uri/ =404;
	}
}
