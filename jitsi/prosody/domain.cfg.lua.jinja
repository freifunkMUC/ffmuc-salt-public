{%- from "jitsi/map.jinja" import jitsi with context %}

-- enable websocket support
consider_websocket_secure = true;

-- settings for bosh interface
consider_bosh_secure = true;

-- domain mapper options, must at least have domain base set to use the mapper
muc_mapper_domain_base = "{{ jitsi.public_domain }}";

http_default_host = "{{ jitsi.xmpp.xmpp_domain }}";
{%- if jitsi.transcription.enabled and jitsi.transcription.disable_dial_out %}

-- the jigasi brewery is used for transcription only, keep SIP dial-out off for moderators
jitsi_default_permissions = {
    livestreaming = true;
    recording = true;
    transcription = true;
    ['outbound-call'] = false;
    ['create-polls'] = true;
    ['send-groupchat'] = true;
    flip = true;
    ['live-translation'] = true;
    ['live-translation-subscribe'] = true;
}
{%- endif %}

VirtualHost "{{ jitsi.xmpp.xmpp_domain }}"
    authentication = {% if jitsi.authentication %}"internal_plain"{% else %}"token"{% endif %}
    ssl = {
            key = "/etc/prosody/certs/{{ jitsi.public_domain }}.key";
            certificate = "/etc/prosody/certs/{{ jitsi.public_domain }}.crt";
    }
    av_moderation_component = "avmoderation.{{ jitsi.public_domain }}"
    speakerstats_component = "speakerstats.{{ jitsi.public_domain }}"
    {%- if jitsi.end_conference_enabled %}
    end_conference_component = "endconference.{{ jitsi.public_domain }}"
    {%- endif %}
    -- we need bosh
    modules_enabled = {
        "bosh";
        "websocket";
        "ping"; -- Enable mod_ping
        "conference_duration";
        {% if jitsi.lobby_enabled %}"muc_lobby_rooms";{% endif %}
        {% if jitsi.breakout_enabled %}"muc_breakout_rooms";{% endif %}
        "external_services";
        "features_identity"; -- advertises speakerstats/avmoderation/polls/metadata components
        {%- if jitsi.visitors.enabled %}
        "visitors";
        {%- endif %}
        {%- if jitsi.visitors.enabled and jitsi.signed_rooms.enabled %}
        "ffmuc_signed_rooms";
        {%- endif %}
    }
    {%- if jitsi.lobby_enabled %}
    lobby_muc = "lobby.{{ jitsi.public_domain }}"
    {%- endif %}
    {% if jitsi.breakout_enabled %}breakout_rooms_muc = "breakout.{{ jitsi.public_domain }}"{% endif %}
    room_metadata_component = "metadata.{{ jitsi.public_domain }}"
    main_muc = "conference.{{ jitsi.public_domain }}"
    c2s_require_encryption = false
    app_id = ""
    app_secret = ""
    allow_empty_token = true
    {%- if jitsi.visitors.enabled %}
    -- jibri and transcribers stay in the main room
    visitors_ignore_list = { "recorder.{{ jitsi.public_domain }}" }
    {%- endif %}
    {%- if jitsi.visitors.enabled and jitsi.signed_rooms.enabled %}
    -- meet.ffmuc.net/reserve rooms; normal rooms keep auto-promoting visitors via room metadata
    ffmuc_signed_rooms_public_keys = {
        {%- for kid, key in jitsi.signed_rooms.public_keys | dictsort %}
        ["{{ kid }}"] = "{{ key }}";
        {%- endfor %}
    }
    ffmuc_signed_rooms_max_extension = {{ jitsi.signed_rooms.max_extension }}
    ffmuc_signed_rooms_auto_promote_unsigned = {{ "true" if jitsi.visitors.auto_allow_promotion else "false" }}
    ffmuc_signed_rooms_focus_jid = "focus@{{ jitsi.xmpp.auth_domain }}"
    ffmuc_signed_rooms_focus_component = "focus.{{ jitsi.public_domain }}"
    ffmuc_signed_rooms_lookup_url = "{{ jitsi.signed_rooms.lookup_url | default('https://' ~ jitsi.public_domain ~ '/reserve/api/room/', true) }}"
    ffmuc_signed_rooms_lookup_ttl = {{ jitsi.signed_rooms.lookup_ttl }}
    ffmuc_signed_rooms_lookup_grace = {{ jitsi.signed_rooms.lookup_grace }}
    {%- endif %}
    {%- if jitsi.transcription.enabled %}
    muc_lobby_whitelist = { "recorder.{{ jitsi.public_domain }}" }
    {%- endif %}

Component "conference.{{ jitsi.public_domain }}" "muc"
    restrict_room_creation = true
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_meeting_id";
        "muc_domain_mapper";
        "muc_rate_limit";
        "muc_password_whitelist";
        "muc_message_moderation";
    }
    admins = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}" }
    muc_password_whitelist = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}"{% if jitsi.transcription.enabled %}, "{{ jitsi.transcription.transcriber_username }}@recorder.{{ jitsi.public_domain }}"{% endif %} }
    muc_room_cache_size = 10000
    muc_room_locking = false
    muc_room_default_public_jids = true

{% for domain in jitsi.subdomains %}
Component "conference.{{ domain }}.{{ jitsi.public_domain }}" "muc"
    restrict_room_creation = true
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_meeting_id";
        "muc_domain_mapper";
        "muc_rate_limit";
        "muc_password_whitelist";
        "muc_message_moderation";
    }
    admins = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}" }
    muc_password_whitelist = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}"{% if jitsi.transcription.enabled %}, "{{ jitsi.transcription.transcriber_username }}@recorder.{{ jitsi.public_domain }}"{% endif %} }
    muc_room_cache_size = 10000
    muc_room_locking = false
    muc_room_default_public_jids = true
{% endfor %}

{% if jitsi.breakout_enabled %}
Component "breakout.{{ jitsi.public_domain }}" "muc"
    restrict_room_creation = true
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_meeting_id";
        "muc_domain_mapper";
        "muc_rate_limit";
        "muc_message_moderation";
    }
    admins = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}", "{{ jitsi.videobridge.username }}@{{ jitsi.xmpp.auth_domain }}" }
    muc_room_locking = false
    muc_room_default_public_jids = true
{% endif %}

-- internal muc component
Component "internal.auth.{{ jitsi.public_domain }}" "muc"
    storage = "memory"
    modules_enabled = {
      "muc_hide_all";
      "ping";
    }
    admins = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}", "{{ jitsi.videobridge.username }}@{{ jitsi.xmpp.auth_domain }}" }
    muc_room_locking = false
    muc_room_default_public_jids = true
    muc_room_cache_size = 10000

VirtualHost "{{ jitsi.xmpp.auth_domain }}"
    ssl = {
        key = "/etc/prosody/certs/{{ jitsi.xmpp.auth_domain }}.key";
        certificate = "/etc/prosody/certs/{{ jitsi.xmpp.auth_domain }}.crt";
    }
    authentication = "{{ jitsi.prosody.auth_backend }}"

-- Proxy to jicofo's user JID, so that it doesn't have to register as a component.
Component "focus.{{ jitsi.public_domain }}" "client_proxy"
    target_address = "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}"

Component "speakerstats.{{ jitsi.public_domain }}" "speakerstats_component"
    muc_component = "conference.{{ jitsi.public_domain }}"

{%- if jitsi.end_conference_enabled %}
Component "endconference.{{ jitsi.public_domain }}" "end_conference"
    muc_component = "conference.{{ jitsi.public_domain }}"
{% endif %}{# if end_conference_enabled #}

Component "avmoderation.{{ jitsi.public_domain }}" "av_moderation_component"
    muc_component = "conference.{{ jitsi.public_domain }}"

{%- if jitsi.authentication %}
-- to allow guests to be able to join as well
VirtualHost "guest.{{ jitsi.public_domain }}"
    authentication = "anonymous"
    ssl = {
            key = "/etc/prosody/certs/{{ jitsi.public_domain }}.key";
            certificate = "/etc/prosody/certs/{{ jitsi.public_domain }}.crt";
    }
    speakerstats_component = "speakerstats.{{ jitsi.public_domain }}"
    -- we need bosh
    modules_enabled = {
        "bosh";
        "websocket";
        "pubsub";
        "ping"; -- Enable mod_ping
        "external_services";
        "conference_duration";
    }
    c2s_require_encryption = false
    {%- if jitsi.visitors.enabled %}
    allow_anonymous_s2s = true
    {%- endif %}
{% endif %}{# if guests_enabled #}

{%- if jitsi.lobby_enabled %}
Component "lobby.{{ jitsi.public_domain }}" "muc"
    storage = "memory"
    muc_room_cache_size = 10000
    restrict_room_creation = true
    muc_room_locking = false
    muc_room_default_public_jids = true
    modules_enabled = {
        "muc_hide_all";
        "muc_rate_limit";
    }
{% endif %}{# if lobby_enabled #}

{%- if jitsi.jibri_enabled or jitsi.transcription.enabled %}
VirtualHost "recorder.{{ jitsi.public_domain }}"
    modules_enabled = {
        "ping";
    }
    authentication = "{{ jitsi.prosody.auth_backend }}"
    c2s_require_encryption = false
    allow_empty_token = true
{% endif %}{# recorder enabled #}

Component "metadata.{{ jitsi.public_domain }}" "room_metadata_component"
    muc_component = "conference.{{ jitsi.public_domain }}"
    breakout_rooms_component = "breakout.{{ jitsi.public_domain }}"

Component "polls.{{ jitsi.public_domain }}" "polls_component"
{%- if jitsi.visitors.enabled %}

Component "visitors.{{ jitsi.public_domain }}" "visitors_component"
    {#- with signed rooms the per-room metadata decides (mod_ffmuc_signed_rooms sets autoPromote on normal rooms) #}
    auto_allow_visitor_promotion = {{ 'true' if jitsi.visitors.auto_allow_promotion and not jitsi.signed_rooms.enabled else 'false' }}
    admins = { "{{ jitsi.jicofo.username }}@{{ jitsi.xmpp.auth_domain }}" }
{%- endif %}