#
# sudoers file for Icinga2 monitoring commands (Salt managed)
#

# No lecture for the nagios user
Defaults: nagios lecture=never

# Network basics (IP, conntrack, routing)
nagios	ALL=NOPASSWD:	/usr/local/share/monitoring-plugins/check_conntrack_size

# BGP sessions in bird, WireGuard handshake age (read only)
nagios	ALL=NOPASSWD:	/usr/sbin/birdc show protocols
nagios	ALL=NOPASSWD:	/usr/bin/wg show all latest-handshakes

# DHCP
nagios  ALL=NOPASSWD:	/usr/local/sbin/dhcpd-pool

# Mail
nagios	ALL=NOPASSWD:	/usr/lib/nagios/plugins/check_mailq

nagios	ALL=NOPASSWD:	/usr/local/share/monitoring-plugins/check_ffmuc_dumps

# Zammad search index: docker exec into the Zammad containers
nagios	ALL=NOPASSWD:	/usr/local/share/monitoring-plugins/check_zammad_index

# Jitsi dial-in: SIP trunk registration in Asterisk (read only)
nagios	ALL=NOPASSWD:	/usr/sbin/asterisk -rx pjsip show registrations
