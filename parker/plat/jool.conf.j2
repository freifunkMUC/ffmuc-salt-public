{
    "comment": "NAT64 configuration",

    "instance": "default",
    "framework": "netfilter",

    "global": {
        "comment": "NAT64 prefix. Fragment DF=0 packets only above the tunnel MTU: the node CLAT drops IPv6 fragments.",
        "pool6": "64:ff9b::/96",
        "lowest-ipv6-mtu": {{ lowest_ipv6_mtu }}
    },

    "pool4": [
        {
            "comment": "IPv4 translation address",
            "prefix": "{{ nat64_pool4 }}",
            "protocol": "TCP",
            "port range": "2000-64999"
        },
        {
            "comment": "IPv4 translation address",
            "prefix": "{{ nat64_pool4 }}",
            "protocol": "UDP",
            "port range": "2000-64999"
        },
        {
            "comment": "IPv4 translation address",
            "prefix": "{{ nat64_pool4 }}",
            "protocol": "ICMP",
            "port range": "2000-64999"
        }
    ]
}
