{%- from 'iptables/nebula_map.jinja' import nebula_node_data_list with context %}
# Managed with Salt

*nat
:PREROUTING ACCEPT
:INPUT ACCEPT
:OUTPUT ACCEPT
:POSTROUTING ACCEPT

-A POSTROUTING -s 10.80.0.0/16 -o {{ uplink_iface }} -j SNAT --to-source {{ nat_ip }}
-A POSTROUTING -s 10.86.0.0/16 -o {{ uplink_iface }} -j SNAT --to-source {{ nat_ip }}
COMMIT

*filter
:INPUT ACCEPT
:FORWARD ACCEPT
:OUTPUT ACCEPT

{#- Block tunnel in tunnel to this gateway #}
{%- set wireguard_port = salt['pillar.get']('netbox:config_context:wireguard:port') %}
-A INPUT -i jool -d {{ nat_ip }} -p udp -m udp --dport {{ wireguard_port }} -j REJECT --reject-with icmp-port-unreachable -m comment --comment "Block tunnel in tunnel"

{#- Keep translated TCP packets at 1280 B IPv6, the minimum IPv6 MTU: MSS = 1280 - 40 B (IPv6 header) - 8 B (Fragment header) - 20 B (TCP header).
    Jool fragments only above lowest-ipv6-mtu (parker/plat), because the node CLAT drops IPv6 fragments. #}
-A FORWARD -i jool -o {{ uplink_iface }} -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1212

{#- Block tunnel in tunnel to other gateways #}
{%- for node,_ in salt['mine.get']('netbox:role:name:parker-gateway', 'minion_id', tgt_type='pillar').items() | sort if
grains.id not in node %}
{%- set external_addresses = salt['mine.get'](node,'minion_external_ip', tgt_type='glob').get(node) or [] %}
{%- if external_addresses %}
{#- TODO create mine function for port to get correct port for each node in case they are different #}
-A FORWARD -i jool -d {{ external_addresses[0].split('/')[0] }} -p udp -m udp --dport {{ wireguard_port }} -j REJECT --reject-with icmp-port-unreachable -m comment --comment "Block tunnel in tunnel"
{%- else %}
# {{ node }}: no minion_external_ip in the Salt mine, no tunnel in tunnel rule. Refresh: salt {{ node }} mine.update
{%- endif %}
{%- endfor %}

-A FORWARD -i jool -o nebula0 -j REJECT --reject-with icmp-port-unreachable

{%- for internal_vlan_if in salt['pillar.get']('netbox:config_context:network:gateway') %}{# vlan1001/1002 #}
{#- Allow nebula traffic from Freifunk Netz to internal network #}
{%- for node in nebula_node_data_list %}
-A FORWARD -o {{ internal_vlan_if }} -d {{ node.minion_address }} -p udp -m udp --dport {{ node.nebula_port }} -j ACCEPT -m comment --comment "{{ node.hostname }}"
{%- endfor %}{# node #}
{#- Block all other traffic to internal network #}
-A FORWARD -i jool -o {{ internal_vlan_if }} -j REJECT --reject-with icmp-port-unreachable
{%- endfor %}{# internal_vlan_if #}

COMMIT
