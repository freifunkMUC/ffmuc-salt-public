{#- Settings for the Jitsi host firewall (jitsi_rules.v4/v6.jinja); NetBox config context `jitsi_firewall` overrides #}
{%- set cfg = salt['pillar.get']('netbox:config_context:jitsi_firewall', {}) %}
{#- Operator addresses for SSH/mosh beyond the nebula-meet overlay and the own prefixes; empty keeps SSH open to everyone #}
{%- set ssh_sources = cfg.get('ssh_sources', []) %}
{#- Web (80/443 on jicofo): own prefixes (webfrontends) and Cloudflare; web_public opens it to everyone #}
{%- set web_public = cfg.get('web_public', false) %}
{#- SIP trunk peers on call01 (everything from them is accepted) #}
{%- set sip_peers = cfg.get('sip_peers', ['185.232.100.76']) %}
{%- set meet_net = '10.111.0.0/24' %}
{%- set own_v4 = ['5.1.66.0/24', '185.150.99.0/24', '172.31.0.0/16'] %}
{%- set own_v6 = ['2001:678:e68::/48', '2001:678:ed0::/48'] %}
{#- Same lists as jitsi/nginx/files/cloudflare-realips.conf #}
{%- set cf_v4 = ['173.245.48.0/20', '103.21.244.0/22', '103.22.200.0/22', '103.31.4.0/22', '141.101.64.0/18', '108.162.192.0/18', '190.93.240.0/20', '188.114.96.0/20', '197.234.240.0/22', '198.41.128.0/17', '162.158.0.0/15', '104.16.0.0/13', '104.24.0.0/14', '172.64.0.0/13', '131.0.72.0/22'] %}
{%- set cf_v6 = ['2400:cb00::/32', '2606:4700::/32', '2803:f800::/32', '2405:b500::/32', '2405:8100::/32', '2a06:98c0::/29', '2c0f:f248::/32'] %}
{#- nebula-meet listens on a random UDP port unless the context nebula-meet.listen.port fixes it #}
{%- set nebula_port = salt['pillar.get']('netbox:config_context:nebula-meet:listen:port', 0) | int(0) %}
{%- set nebula_dport = nebula_port if nebula_port > 0 else '32768:60999' %}
{#- nft: native nftables table instead of iptables (LXC on a host without nft_compat/xt modules, e.g. jvb33); jvb only #}
{%- set backend = cfg.get('backend', 'iptables') %}
