[Unit]
Description=respondd (respondd status for servers)
After=syslog.target network-online.target
# the mesh interface may not be routable yet at boot (OSError: Network is unreachable); keep retrying
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/respondd-%I
ExecStart=/opt/respondd-%I/ext-respondd.py
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
