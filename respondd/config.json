{
  "batman": "bat-{{ site  }}",
  {%- if "gw02.in.ffmuc.net" in grains['id']  %}
  "bridge": "veth-{{ site }}",
  {%- else %}
  "bridge": "br-{{ site }}",
  {%- endif %}
  {%- if 'nextgen-gateway' in salt['pillar.get']('netbox:role:name') %}
  "mesh-vpn": [ "vx-{{ site }}", "wg-{{ site }}" ],
  {%-else %}
  "mesh-vpn": [],
  {%- endif %}
  {%- if 'VIE01' in salt['pillar.get']('netbox:site:name') %}
  "wan": "vlan101",
  {%-else %}
  "wan": "vlan3",
  {%- endif %}
  "rate_limit": 30,
  "rate_limit_burst": 10
}
