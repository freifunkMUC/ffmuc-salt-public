---

version: "3.5"

services:
  analyzer:
    image: {{ analyzer['image'] }}
    container_name: packetyeeter-analyzer
    restart: unless-stopped
    command:
      - "-listen-addr=0.0.0.0:9090"
      - "-metrics-addr=0.0.0.0:9091"
      - "-inspect-addr=0.0.0.0:9092"
      - "-reputation-threshold={{ analyzer['reputation_threshold'] }}"
      - "-ai-confidence-threshold={{ analyzer['ai_confidence_threshold'] }}"
      {%- if analyzer['geoip_enabled'] %}
      - "-geoip-asn={{ analyzer['geoip_container_path'] }}"
      {%- endif %}
      - "-geoip-country={{ analyzer['geoip_country_container_path'] }}"
      {%- if analyzer['dry_run'] %}
      - "-dry-run"
      {%- endif %}
      {%- if analyzer['verbose'] %}
      - "-v"
      {%- endif %}
      {#- v0.1.9+ sustained-download detection. Emitted ONLY when enabled, so
          a <=v0.1.8 image never sees these unknown flags. -sustained-enforce
          is only added alongside -sustained-enabled (enforce is meaningless
          without detection); keep enforce off on the first rollout. #}
      {%- if analyzer['sustained_enabled'] %}
      - "-sustained-enabled"
      {%- if analyzer['sustained_enforce'] %}
      - "-sustained-enforce"
      {%- endif %}
      {%- endif %}
    ports:
      - "{{ analyzer['listen_port'] }}:9090"
      - "{{ analyzer['metrics_port'] }}:9091"
      - "127.0.0.1:{{ analyzer['inspect_port'] }}:9092"
    volumes:
      - "./data:/data"
      - "./ml-data:/var/lib/packetyeeter"
      - "./ml-data/sessions:/var/cache/packetyeeter/sessions"
      - "{{ analyzer['geoip_country_host_path'] }}:{{ analyzer['geoip_country_container_path'] }}:ro"
      {%- if analyzer['geoip_enabled'] %}
      - "{{ analyzer['geoip_host_path'] }}:{{ analyzer['geoip_container_path'] }}:ro"
      {%- endif %}
    {%- if analyzer['traefik_host'] %}
    networks:
      - default
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.middlewares.packetyeeter-https-redirect.redirectscheme.scheme=https"
      - "traefik.http.routers.packetyeeter.entrypoints=http"
      - "traefik.http.routers.packetyeeter.rule=Host(`{{ analyzer['traefik_host'] }}`)"
      - "traefik.http.routers.packetyeeter.middlewares=packetyeeter-https-redirect"
      - "traefik.http.routers.packetyeeter-secure.entrypoints=https"
      - "traefik.http.routers.packetyeeter-secure.rule=Host(`{{ analyzer['traefik_host'] }}`)"
      - "traefik.http.routers.packetyeeter-secure.tls=true"
      - "traefik.http.routers.packetyeeter-secure.tls.certresolver=http"
      - "traefik.http.routers.packetyeeter-secure.service=packetyeeter"
      - "traefik.http.services.packetyeeter.loadbalancer.server.port=9092"

networks:
  proxy:
    external: true
    {%- endif %}
