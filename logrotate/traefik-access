# Traefik access log on docker hosts (stacks/<host>/traefik). Short retention until a retention
# period for access logs is agreed; copytruncate because Traefik keeps the file open.
/srv/docker/traefik/logs/access.log
{
        rotate 3
        daily
        maxsize 100M
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
}
