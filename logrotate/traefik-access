# Traefik access log on docker hosts (stacks/<host>/traefik): kept 7 days, then deleted.
# copytruncate because Traefik keeps the file open.
/srv/docker/traefik/logs/access.log
{
        rotate 6
        maxage 7
        daily
        maxsize 100M
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
}
