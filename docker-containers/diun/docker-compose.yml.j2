---

services:
  diun:
    image: crazymax/diun:latest
    hostname: {{ grains.id.split('.')[0] }}-diun
    volumes:
      - "./data:/data"
      - "./diun.yml:/diun.yml:ro"
      # Read-only: diun only needs to enumerate images. The socket is still
      # root-equivalent on this host, so keep the image trusted.
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
    environment:
      - "TZ=Europe/Berlin"
      - "LOG_LEVEL=info"
      - "LOG_JSON=false"
    restart: always
