# Managed by Salt (docker-containers/meet-reserve)
services:
  meet-reserve:
    build: ./src
    image: ffmuc/meet-reserve:local
    restart: always
    env_file: .env
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    volumes:
      - ./data:/data
    ports:
      - "{{ port }}:8095"
      - "127.0.0.1:{{ metrics_port }}:9195"
{%- if sync_ip %}
      - "{{ sync_ip }}:8096:8096"
{%- endif %}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
