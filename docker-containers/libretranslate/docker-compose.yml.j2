# Managed by Salt (docker-containers/libretranslate)
services:
  libretranslate:
    image: {{ image }}
    restart: always
    environment:
      LT_LOAD_ONLY: "{{ languages }}"
      LT_THREADS: "{{ threads }}"
      LT_CHAR_LIMIT: "2000"
      LT_DISABLE_WEB_UI: "true"
      LT_DISABLE_FILES_TRANSLATION: "true"
    ports:
      - "{{ port }}:5000"
    volumes:
      # Argos models, downloaded once on first start
      - models:/home/libretranslate/.local:rw
    mem_limit: {{ mem_limit }}
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      test: ["CMD-SHELL", "./venv/bin/python scripts/healthcheck.py"]
      interval: 30s
      timeout: 5s
      retries: 4
      start_period: 10m
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

volumes:
  models:
