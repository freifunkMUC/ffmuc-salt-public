{#- Master-side pillar (not rendered by minions): one x509_v2 signing policy per minion. -#}
{#- Master config, the ca_server minion holds the signing key (master uses re.match):
      peer:
        '.+\.ffmuc\.net$': [x509.sign_remote_certificate]
-#}
{#- Literal list: pillar.get('x509_hosts') is unreliable while the pillar compiles. -#}
{#- Entry: plain id, or {id: ..., sans: [...]} for extra DNS SANs fixed by this policy (never by the minion).
    The CA's nameConstraints (.ffmuc.net) reject any SAN outside that domain anyway. -#}
{% set x509_hosts = ['host01.in.ffmuc.net', {'id': 'metrics.in.ffmuc.net', 'sans': ['metrics.ov.ffmuc.net', 'stats.meet.ffmuc.net']}] %}
x509_signing_policies:
{% for e in x509_hosts %}
{% set h = e if e is string else e['id'] %}
{% set names = [h] + ([] if e is string else e['sans']) %}
  host-{{ h }}:
    minions: {{ h }}
    signing_private_key: /etc/pki/ffmuc-int.key
    signing_cert: /etc/pki/ffmuc-int.crt
    copypath: /etc/pki/issued
    CN: {{ h }}
    subjectAltName: "DNS:{{ names | join(', DNS:') }}"
    basicConstraints: "critical, CA:FALSE"
    keyUsage: "critical, digitalSignature"
    extendedKeyUsage: "serverAuth, clientAuth"
    subjectKeyIdentifier: hash
    authorityKeyIdentifier: keyid
    days_valid: 90
{% endfor %}
