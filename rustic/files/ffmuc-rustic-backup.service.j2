[Unit]
Description=FFMuc rustic Backup

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
{%- if salt['config.get']('netbox:config_context:backup:dump_commands', {}) %}
ExecStartPre=/usr/local/sbin/ffmuc-rustic-dumps.sh
{%- endif %}
ExecStart=/usr/local/bin/rustic backup
ExecStart=/usr/local/bin/rustic forget
