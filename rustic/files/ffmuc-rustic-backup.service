[Unit]
Description=FFMuc rustic Backup

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/bin/rustic backup
# forget of another host can delete a snapshot file while this one lists them (404): retry once
ExecStart=/bin/sh -c '/usr/local/bin/rustic forget || { sleep 300; /usr/local/bin/rustic forget; }'
ExecStartPost=/usr/bin/touch /var/lib/ffmuc-rustic-last-success
